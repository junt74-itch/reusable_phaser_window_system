{
  "name": "reusable-phaser4-window-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "check": "bun test && bun run typecheck && bun run build",
    "font:sync": "bun run scripts/sync-font-assets.ts"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
